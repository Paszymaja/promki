LIDL_ACCESS_TOKEN=

GEMINI_API_KEY=

# Recipe backend: "gemini" (default) or "ollama"
RECIPE_PROVIDER=
# Ollama server URL (default: http://localhost:11434); model is hardcoded to gemma4-fast
OLLAMA_URL=

# Kaufland session is stored in kaufland_session.json (managed automatically via --login)
# Run `uv run promki --login` to capture both Lidl and Kaufland auth tokens.
